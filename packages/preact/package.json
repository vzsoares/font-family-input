{
  "name": "@font-family-input/preact",
  "version": "0.1.0",
  "description": "Composable, unstyled Preact primitives for a virtualized font-family picker.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@font-family-input/core": "workspace:*",
    "@tanstack/virtual-core": "^3.11.2"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "preact": "^10.25.4"
  }
}
