{
  "name": "@font-family-input/vue",
  "version": "0.0.0",
  "description": "Composable, unstyled Vue primitives for a virtualized font-family picker.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@font-family-input/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/vue-virtual": "^3.11.2",
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@tanstack/vue-virtual": "^3.11.2",
    "@vue/test-utils": "^2.4.6",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
