{
  "name": "@font-family-input/core",
  "version": "0.0.0",
  "description": "Headless, framework-agnostic engine for a composable font-family picker.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
